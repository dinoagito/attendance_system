# Fingerprint Server Environment Configuration
# Copy this file to .env and update values

# Database Configuration (MySQL)
# For local development keep localhost/attendance_app. For Railway, copy the
# MySQL service's public variables (DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME)
# and set DB_SSL=true.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=attendance_app
DB_SSL=true

# Server Configuration
PORT=3001
WS_PORT=3002

# HTTPS — dual-mode: when true and cert files exist, serve wss/https; otherwise fallback to http
# For portable zero-cert kiosk (no mkcert), keep FINGERPRINT_SSL=false
FINGERPRINT_SSL=false
TLS_KEY_PATH=./certs/127.0.0.1+2-key.pem
TLS_CERT_PATH=./certs/127.0.0.1+2.pem

# CORS — comma-separated allowed browser Origins (fingerprint-server stays at 127.0.0.1:3001)
CORS_ORIGINS=https://attendancesystem-production-e301.up.railway.app,http://localhost:8000,http://127.0.0.1:8000

# ZKTeco SDK Path (update to your SDK installation path)
ZKTECO_SDK_PATH=C:/Program Files/ZKTeco/ZK9500/

# Laravel API URL
LARAVEL_API_URL=http://localhost:8000/api

# Fingerprint Settings
FINGERPRINT_THRESHOLD=50
MAX_TEMPLATE_SIZE=2048
